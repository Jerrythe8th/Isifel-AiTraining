# ============================================================
# FREE STABLE DIFFUSION GPU MEMORY
# ============================================================

def unload_image_model():

    global pipe

    if pipe is None:
        return

    print()
    print("🧹 Freeing Stable Diffusion memory...")

    try:

        if device == "cuda":
            pipe.to("cpu")

    except Exception as e:

        print(
            "⚠️ Could not move Stable Diffusion to CPU:",
            e
        )

    try:
        del pipe
    except:
        pass

    pipe = None

    gc.collect()

    if torch.cuda.is_available():

        try:
            torch.cuda.empty_cache()
            torch.cuda.ipc_collect()
        except:
            pass

    print("✅ Stable Diffusion memory released.")


