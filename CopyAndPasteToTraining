# ============================================================
# PYTHON VALIDATION
# ============================================================

def validate_python_source(source):

    try:

        # Google Colab allows shell commands beginning with !.
        # Python's compile() does not understand those commands.
        # Remove those lines ONLY for syntax validation.
        validation_source = re.sub(
            r"(?m)^[ \t]*!.*(?:\n|$)",
            "",
            source
        )

        compile(
            validation_source,
            "<generated_isifel>",
            "exec"
        )

        return (
            True,
            "Python/Colab syntax check passed."
        )

    except SyntaxError as e:

        return (
            False,
            (
                f"Syntax error on line "
                f"{e.lineno}: {e.msg}"
            )
        )

    except Exception as e:

        return (
            False,
            str(e)
        )

# ============================================================
# VERSION CALCULATOR
# ============================================================

def next_training_version():

    current = TRAINING_VERSION

    try:

        parts = current.split(".")

        major = int(
            parts[0]
        )

        minor = int(
            parts[1]
        )

        minor += 1

        return (
            f"{major}.{minor}"
        )

    except:

        return "1.1"


# ============================================================
# CLEAN GENERATED PYTHON
# ============================================================

def clean_generated_python(text):

    text = text.strip()

    if text.startswith("```"):

        text = re.sub(
            r"^```(?:python|py)?\s*",
            "",
            text,
            flags=re.IGNORECASE
        )

        text = re.sub(
            r"\s*```$",
            "",
            text
        )

    return text.strip()


