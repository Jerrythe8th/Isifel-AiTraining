        svd_pipe.enable_model_cpu_offload()

        try:
            svd_pipe.enable_vae_slicing()
        except:
            pass

        try:
            svd_pipe.enable_vae_tiling()
        except:
            pass

        print("✅ Smaller video AI ready.")

        return True

    except Exception as e:

        print(
            "❌ Video model failed to load:",
            e
        )

        svd_pipe = None

        gc.collect()

        try:

            torch.cuda.empty_cache()
            torch.cuda.ipc_collect()

        except:
            pass

        return False

    finally:

        svd_loading = False


