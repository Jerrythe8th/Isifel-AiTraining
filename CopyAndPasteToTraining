def create_video(_=None):

    global current_video
    global current_image

    if current_image is None:

        set_status(
            "GENERATE AN IMAGE FIRST",
            RED
        )

        with video_output:

            clear_output(
                wait=True
            )

            print(
                "Generate an image in the Create tab first."
            )

        return

    if device != "cuda":

        set_status(
            "CUDA GPU REQUIRED",
            RED
        )

        return

    base = current_image.convert(
        "RGB"
    )

    target_width = 576
    target_height = 320

    base.thumbnail(
        (
            target_width,
            target_height
        ),
        Image.Resampling.LANCZOS
    )

    canvas = Image.new(
        "RGB",
        (
            target_width,
            target_height
        ),
        "black"
    )

    canvas.paste(
        base,
        (
            (target_width-base.width)//2,
            (target_height-base.height)//2
        )
    )

    base = canvas

    if svd_pipe is None:

        set_status(
            "LOADING SMALL VIDEO AI...",
            ORANGE
        )

        with video_output:

            clear_output(
                wait=True
            )

            display(
                HTML(
                    """
                    <h3>🎬 Loading smaller Isifel Video AI...</h3>
                    <p style='color:#8b95a5;'>
                    This replaces CogVideoX-5B and does not require
                    a Hugging Face login.
                    </p>
                    """
                )
            )

        if not load_video_model():
            return

    set_status(
        "GENERATING AI VIDEO...",
        ORANGE
    )

    with video_output:

        clear_output(
            wait=True
        )

        display(
            HTML(
                """
                <h3>🎬 Generating Isifel Video...</h3>
                <p style='color:#8b95a5;'>
                Using the smaller local image-to-video model.
                </p>
                """
            )
        )

    if video_seed.value < 0:

        used_seed = random.randint(
            0,
            999999999
        )

    else:

        used_seed = video_seed.value

    generator = torch.Generator(
        device="cuda"
    ).manual_seed(
        used_seed
    )

    try:

        result = svd_pipe(
            image=base,
            num_frames=14,
            num_inference_steps=min(
                video_steps.value,
                25
            ),
            decode_chunk_size=2,
            fps=7,
            motion_bucket_id=127,
            noise_aug_strength=0.02,
            generator=generator
        )

        frames = result.frames[0]

        filename = (
            "/content/isifel_video_"
            + datetime.now().strftime(
                "%H%M%S"
            )
            + ".mp4"
        )

        export_to_video(
            frames,
            filename,
            fps=7
        )

        if (
            not os.path.exists(filename)
            or os.path.getsize(filename) < 1000
        ):

            raise RuntimeError(
                "Video file was not created correctly."
            )

        current_video = filename

        with video_output:

            clear_output(
                wait=True
            )

            display(
                HTML(
                    "<h3>🎬 Isifel Video</h3>"
                )
            )

            display(
                Video(
                    filename,
                    embed=True,
                    width=700
                )
            )

            display(
                HTML(
                    f"""
                    <p style='color:#8b95a5;'>
                    ✅ Video created successfully.
                    </p>

                    <p style='color:#8b95a5;'>
                    Seed: {used_seed}
                    </p>

                    <p style='color:#8b95a5;'>
                    Model: Smaller Stable Video Diffusion
                    </p>
                    """
                )
            )

        set_status(
            "VIDEO READY",
            GREEN
        )

    except torch.cuda.OutOfMemoryError:

        set_status(
            "VIDEO NEEDS MORE VRAM",
            RED
        )

        with video_output:

            clear_output(
                wait=True
            )

            print(
                "❌ CUDA OUT OF MEMORY — "
                "try fewer steps or restart the Colab runtime."
            )

        try:
            torch.cuda.empty_cache()
        except:
            pass

    except Exception as e:

        set_status(
            "VIDEO ERROR",
            RED
        )

        with video_output:

            clear_output(
                wait=True
            )

            print(
                "❌ Video generation error:"
            )

            print(e)


