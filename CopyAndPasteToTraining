# ============================================================
# PATTERN GENERATOR
# ============================================================

def create_pattern():

    global current_prompt

    n = point_count.value

    x = np.random.uniform(
        0,
        100,
        n
    )

    y = np.random.uniform(
        0,
        100,
        n
    )

    order = np.random.permutation(n)

    random_words = words.copy()

    random.shuffle(
        random_words
    )

    sentence = (
        " ".join(
            random_words[
                :sentence_length.value
            ]
        ).capitalize()
        + "."
    )

    current_prompt = sentence

    prompt.value = sentence

    return x, y, order


# ============================================================
# SHOW PATTERN
# ============================================================

def show_pattern():

    with dots_output:

        clear_output(
            wait=True
        )

        x, y, order = create_pattern()

        plt.figure(
            figsize=(8,8)
        )

        plt.plot(
            x[order],
            y[order],
            "-",
            linewidth=line_width.value
        )

        plt.scatter(
            x,
            y,
            s=point_size.value
        )

        if show_numbers.value:

            for i, (px, py) in enumerate(
                zip(x, y),
                1
            ):

                plt.text(
                    px + .7,
                    py + .7,
                    str(i),
                    fontsize=6
                )

        plt.xlim(0,100)
        plt.ylim(0,100)

        if show_grid.value:

            plt.grid(
                True,
                alpha=.25
            )

        else:

            plt.grid(False)

        plt.gca().set_aspect(
            "equal"
        )

        plt.title(
            f"Random Pattern • {point_count.value} Points"
        )

        plt.show()


