def _attachment_html(item):

    kind = item.get(
        "kind",
        "file"
    )

    name = html.escape(
        item.get(
            "name",
            "attachment"
        )
    )

    path = item.get(
        "path",
        ""
    )

    if kind == "image" and path:

        return (
            f'<div style="margin-top:8px;">'
            f'<img src="{path}" '
            f'style="max-width:320px;max-height:220px;'
            f'border-radius:10px;border:1px solid {BORDER};">'
            f'</div>'
        )

    if kind == "video" and path:

        return (
            f'<div style="margin-top:8px;">'
            f'<video controls '
            f'style="max-width:360px;max-height:240px;'
            f'border-radius:10px;border:1px solid {BORDER};">'
            f'<source src="{path}">'
            f'</video>'
            f'</div>'
        )

    return (
        f'<div style="margin-top:8px;'
        f'color:{MUTED};">'
        f'📎 {name}'
        f'</div>'
    )


def refresh_chat():

    with chat_display:

        clear_output(
            wait=True
        )

        for item in chat_history:

            speaker = item[0]

            text = item[1]

            attachments = (
                item[2]
                if len(item) > 2
                else []
            )

            safe_text = (
                html.escape(
                    str(text)
                )
                .replace(
                    "\n",
                    "<br>"
                )
            )

            media = "".join(
                _attachment_html(a)
                for a in attachments
            )

            if speaker == "You":

                display(
                    HTML(
                        f'''
                        <div style="
                            background:#1d4ed8;
                            color:white;
                            padding:10px 14px;
                            border-radius:12px;
                            margin:8px;
                        ">
                            <b>You</b><br>
                            {safe_text}
                            {media}
                        </div>
                        '''
                    )
                )

            else:

                display(
                    HTML(
                        f'''
                        <div style="
                            background:#171c24;
                            color:#f1f5f9;
                            padding:10px 14px;
                            border-radius:12px;
                            margin:8px;
                        ">
                            <b>🤖 Isifel</b><br>
