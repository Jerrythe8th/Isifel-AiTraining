# ============================================================

def ask_external_training_ai(
    source,
    profile,
    model_name
):

    if not OPENAI_AVAILABLE:

        raise RuntimeError(
            "The OpenAI Python package is unavailable. "
            "Restart the Colab runtime after installation."
        )

    api_key_value = (
        training_openai_key.value.strip()
    )

    if not api_key_value:

        raise RuntimeError(
            "Enter an OpenAI API key first."
        )

    if not model_name.strip():

        raise RuntimeError(
            "Enter an AI model name."
        )

    try:

        client = OpenAI(
            api_key=api_key_value
        )

    except Exception as e:

        raise RuntimeError(
            f"Could not initialize OpenAI client: {e}"
        )


    # --------------------------------------------------------
    # SYSTEM INSTRUCTIONS
    # --------------------------------------------------------

    system_prompt = """
You are the code-improvement engine for a Python application
called Isifel.

Your job is to improve the supplied Isifel Python source code.

IMPORTANT RULES:

1. Return ONLY COMPLETE Python SOURCE CODE.
2. Do NOT return Markdown.
3. Do NOT return explanations.
4. Do NOT return a patch.
5. Do NOT return only changed functions.
6. Return the ENTIRE Python file.
7. Preserve existing working features.
8. Do not delete major features merely to simplify the code.
9. Keep Google Colab compatibility.
10. Keep ipywidgets compatibility.
11. Keep the Isifel application self-contained.
12. Do not invent package names.
13. Do not invent APIs.
14. Do not insert fake API keys.
15. Never hard-code an API key into the generated source.
16. Preserve the Training Lab.
17. Preserve the training access key.
18. Preserve image generation.
19. Preserve chat.
20. Preserve video generation.
21. Preserve API key management.
22. Preserve navigation.
23. Preserve Settings.
24. Preserve History.
25. Improve error handling when useful.
26. Improve readability when useful.
27. Do not replace working implementations with pseudocode.
28. Do not intentionally break dependencies.
29. Do not remove functionality unless requested.
30. The result must be executable Python.
"""

    user_prompt = f"""
CURRENT ISIFEL SOURCE:

================ SOURCE START ================

{source}

================ SOURCE END ==================


REQUESTED TRAINING / IMPROVEMENTS:

{profile}


Create the COMPLETE improved Isifel Python file.

Apply the requested improvements directly to the code.

Preserve all existing major features.

Return ONLY the complete Python source code.
"""

    try:

        response = client.responses.create(
            model=model_name.strip(),
            instructions=system_prompt,
            input=user_prompt
        )

        result = response.output_text

    except Exception as e:

        raise RuntimeError(
            f"AI training request failed:\n{e}"
        )

    result = clean_generated_python(
        result
    )

    if not result:

        raise RuntimeError(
            "The training AI returned empty code."
        )

    return result


