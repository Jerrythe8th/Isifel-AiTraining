def _training_profile():

    goals = training_goals.value.strip()

    examples = training_examples.value.strip()

    behavior = training_instruction.value.strip()

    parts = []

    if goals:

        parts.append(
            "TRAINING GOALS:\n"
            + goals
        )

    if behavior:

        parts.append(
            "BEHAVIOR RULES:\n"
            + behavior
        )

    if examples:

        parts.append(
            "RESPONSE EXAMPLES:\n"
            + examples
        )

    return "\n\n".join(
        parts
    ).strip()


