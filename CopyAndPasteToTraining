def generate_image():

    global current_image
    global pipe

    if pipe is None:

        set_status(
            "LOADING IMAGE MODEL...",
            ORANGE
        )

        try:

            if device == "cuda":

                pipe = StableDiffusionPipeline.from_pretrained(
                    "runwayml/stable-diffusion-v1-5",
                    torch_dtype=torch.float16,
                    safety_checker=None
                )

                pipe = pipe.to("cuda")

            else:

                pipe = StableDiffusionPipeline.from_pretrained(
                    "runwayml/stable-diffusion-v1-5",
                    torch_dtype=torch.float32,
                    safety_checker=None
                )

                pipe = pipe.to("cpu")

        except Exception as e:

            set_status(
                "IMAGE MODEL FAILED",
                RED
            )

            with image_output:

                clear_output(wait=True)

                print(e)

            return

    text = prompt.value.strip()

    if not text:

        set_status(
            "ENTER A PROMPT FIRST",
            RED
        )

        return

    set_status(
        "GENERATING IMAGE...",
        ORANGE
    )

    with image_output:

        clear_output(
            wait=True
        )

        ai_prompt = (
            text
            + ", "
            + style.value
            + ", highly detailed, cinematic lighting, "
              "professional composition, detailed environment"
        )

        seed = seed_box.value

        if seed < 0:

            used_seed = random.randint(
                0,
                999999999
            )

        else:

            used_seed = seed

        generator = torch.Generator(
            device=device
        ).manual_seed(
            used_seed
        )

        try:

            result = pipe(
                ai_prompt,
                negative_prompt=negative_prompt.value,
                num_inference_steps=steps.value,
                guidance_scale=guidance.value,
                width=resolution.value,
                height=resolution.value,
                generator=generator
            )

            current_image = result.images[0]

            display(
                current_image
            )

            history.append({
                "time":
                    datetime.now().strftime(
                        "%H:%M:%S"
                    ),

                "prompt":
                    text,

                "seed":
                    used_seed,

                "image":
                    current_image
            })

        except Exception as e:

            print(
                "❌ Image generation error:"
            )

            print(e)

            set_status(
                "IMAGE ERROR",
                RED
            )

            return

    set_status(
        "IMAGE READY",
        GREEN
    )


