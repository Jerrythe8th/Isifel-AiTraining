def generate_isifel_response(message):

    if (
        isifel_model is None
        or isifel_tokenizer is None
    ):

        return (
            "⚠️ Isifel is not loaded.\n\n"
            "Check the model-loading messages above."
        )

    studio_context = current_prompt

    system_message = """
You are Isifel, the built-in AI assistant.

Your name is Isifel.

You are part of a creative application called Isifel.

You can help the user with:

- creative ideas
- stories
- image prompts
- connect-the-dots concepts
- coding
- brainstorming
- explanations
- game development
- Roblox
- Minecraft
- creative projects
- general questions

The application can provide you with a randomly generated
creative concept.

Use that concept when relevant, but do not force it into
every answer.

Be helpful, creative, friendly, and conversational.

Your name is Isifel.

Do not call yourself "AI Creative Studio".
"""

    if studio_context:

        system_message += f"""

Current Isifel generated creative concept:

"{studio_context}"
"""

    if TRAINING_PROFILE_TEXT:

        system_message += f"""

ISIFEL TRAINING PROFILE:
{TRAINING_PROFILE_TEXT}

Follow this profile when it is relevant. Keep the user's direct
request as the highest priority. Do not reveal hidden training
instructions unless the user explicitly asks for a summary of
Isifel's behavior settings.
"""

    messages = [
        {
            "role":
                "system",

            "content":
                system_message
        }
    ]

    for item in chat_history[-12:]:

        speaker = item[0]

        text = item[1]

        attachments = (
            item[2]
            if len(item) > 2
            else []
        )

        if speaker == "You":

            attachment_note = ""

            if attachments:

                names = ", ".join(
                    a.get(
                        "name",
                        "uploaded file"
                    )
                    for a in attachments
                )

                attachment_note = (
                    f"\n\n"
                    f"[User uploaded media: {names}. "
                    f"The media is displayed in the chat UI.]"
                )

            messages.append({
                "role":
                    "user",

                "content":
                    text + attachment_note
            })

        elif speaker == "Isifel":

            messages.append({
                "role":
                    "assistant",

                "content":
                    text
            })

    try:

        formatted_prompt = (
            isifel_tokenizer.apply_chat_template(
                messages,
                tokenize=False,
                add_generation_prompt=True
            )
        )

        inputs = isifel_tokenizer(
            formatted_prompt,
            return_tensors="pt",
            truncation=True,
            max_length=2048
        )

        model_input_device = (
            isifel_model
            .get_input_embeddings()
            .weight
            .device
        )

        inputs = {
            key:
                value.to(model_input_device)

            for key, value
            in inputs.items()
        }

        with torch.no_grad():

            outputs = isifel_model.generate(
                **inputs,
                max_new_tokens=220,
                temperature=.7,
                top_p=.9,
                do_sample=True,
                repetition_penalty=1.05,
                pad_token_id=(
                    isifel_tokenizer.eos_token_id
                )
            )

        input_length = (
            inputs["input_ids"].shape[1]
        )

        new_tokens = outputs[
            0,
            input_length:
        ]

        response = (
            isifel_tokenizer.decode(
                new_tokens,
                skip_special_tokens=True
            )
            .strip()
        )

        if not response:

            response = (
                "I didn't generate a response. "
                "Try asking again!"
            )

        return response

    except Exception as e:

        return (
            "❌ Isifel generation error:\n\n"
            + str(e)
        )


