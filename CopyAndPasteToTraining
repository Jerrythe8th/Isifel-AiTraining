    svd_loading = True

    try:

        print()
        print("============================================================")
        print("🎬 Loading smaller Isifel video AI...")
        print("Model:", SVD_MODEL_NAME)
        print("============================================================")

        unload_image_model()

        gc.collect()

        try:

            torch.cuda.empty_cache()
            torch.cuda.ipc_collect()

        except:
            pass

        print("⬇️ Downloading/loading video model...")
        print("No Hugging Face login is required.")

        svd_pipe = StableVideoDiffusionPipeline.from_pretrained(
            SVD_MODEL_NAME,
            torch_dtype=torch.float16
