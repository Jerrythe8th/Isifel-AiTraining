def process_chat_uploads():

    global chat_attachments

    chat_attachments = []

    if not chat_upload.value:
        return

    upload_dir = "/content/isifel_chat_uploads"

    os.makedirs(
        upload_dir,
        exist_ok=True
    )

    values = chat_upload.value

    if isinstance(values, dict):

        values = list(
            values.values()
        )

    import base64

    for item in values:

        name = item.get(
            "name",
            "upload"
        )

        data = item.get(
            "content",
            b""
        )

        path = os.path.join(
            upload_dir,
            name
        )

        with open(
            path,
            "wb"
        ) as f:

            f.write(data)

        lower = name.lower()

        kind = (
            "image"
            if lower.endswith(
                (
                    ".png",
                    ".jpg",
                    ".jpeg",
                    ".gif",
                    ".webp",
                    ".bmp"
                )
            )
            else
            "video"
            if lower.endswith(
                (
                    ".mp4",
                    ".webm",
                    ".mov",
                    ".avi",
                    ".mkv"
                )
            )
            else
            "file"
        )

        ext = (
            os.path.splitext(name)[1]
            .lower()
            .replace(
                ".",
                ""
            )
        )

        mime = (
            "image/jpeg"
            if kind == "image"
            and ext in (
                "jpg",
                "jpeg"
            )
            else
            (
                f"image/{ext}"
                if kind == "image"
                else
                f"video/"
                f"{'mp4' if ext == 'mov' else ext}"
            )
        )

        encoded = (
            base64.b64encode(
                data
            ).decode(
                "ascii"
            )
        )

        chat_attachments.append({
            "name":
                name,

            "path":
                f"data:{mime};base64,{encoded}",

            "kind":
                kind,

            "size":
                len(data)
        })


def chat_send_message(_=None):

    process_chat_uploads()

    message = chat_input.value.strip()

    if (
        not message
        and not chat_attachments
    ):
        return

    if not message:

        message = (
            "Please look at the media I uploaded."
        )

    attachments = list(
        chat_attachments
    )

    chat_history.append(
        (
            "You",
            message,
            attachments
        )
    )

    chat_attachments.clear()

    chat_upload.value = ()

    chat_input.value = ""

    refresh_chat()

    set_status(
        "ISIFEL THINKING...",
        PURPLE
    )

    response = generate_isifel_response(
        message
    )

    chat_history.append(
        (
            "Isifel",
            response,
            []
        )
    )

    refresh_chat()

    set_status(
        "ISIFEL READY",
        GREEN
    )


chat_send.on_click(
    chat_send_message
)


